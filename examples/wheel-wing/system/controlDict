FoamFile
{
    format      ascii;
    class       dictionary;
    location    "system";
    object      controlDict;
}

solver          incompressibleFluid;

startFrom       latestTime;
startTime       0;
stopAt          endTime;
endTime         2000;       // Allrun sets this from its second argument
deltaT          1;
writeControl    timeStep;
writeInterval   500;
purgeWrite      2;
writeFormat     binary;
writePrecision  8;
timeFormat      general;
timePrecision   6;
runTimeModifiable true;

// Forces in N (rho = 1.205). The chart script reads them:
//   plot_convergence.py <case> charts ww "..." --total forcesTotal --parts forcesWing:Wing,forcesWheel:Wheel --uinf 15
forceDefaults
{
    type        forces;
    libs        ("libforces.so");
    rho         rhoInf;
    rhoInf      1.205;
    CofR        (0 0 0);
    writeControl timeStep;
    writeInterval 1;
    log         no;
}

functions
{
    #includeFunc residuals(p, U, k, omega)
    #includeFunc yPlus
    #includeFunc time

    forcesTotal { $forceDefaults; patches (modelGroup); }
    forcesWing  { $forceDefaults; patches (model_wing); }
    forcesWheel { $forceDefaults; patches (model_wheel); }
}

