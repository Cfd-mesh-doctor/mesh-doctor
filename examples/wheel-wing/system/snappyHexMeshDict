FoamFile
{
    format      ascii;
    class       dictionary;
    location    "system";
    object      snappyHexMeshDict;
}

// Background 0.1 m; level n = 0.1 / 2^n m: L3 12.5 mm, L4 6.25 mm, L5 3.1 mm, L6 1.6 mm.

castellatedMesh true;
snap            true;
addLayers       true;

geometry
{
    model      { type triSurface; file "model.stl"; }       // solids: wing, wheel -> patches model_wing, model_wheel
    farWake    { type box; min (-3.0 -0.5 0); max (1.3 1.1 0.8); }     // L1
    near       { type box; min (-1.2 -0.3 0); max (0.9 0.85 0.55); }   // L2
    close      { type box; min (-0.5 -0.15 0); max (0.8 0.7 0.35); }  // L3: wheel wake, wing wake
    wingZone   { type box; min (0.30 -0.06 0.02); max (0.72 0.61 0.14); } // L4: around the wing and its ground gap
    contact    { type box; min (-0.10 0.33 0); max (0.10 0.57 0.035); }   // L5: the tyre contact patch
};

castellatedMeshControls
{
    maxLocalCells       2000000;
    maxGlobalCells      8000000;
    minRefinementCells  10;
    maxLoadUnbalance    0.10;
    nCellsBetweenLevels 3;

    features ( { file "model.eMesh"; level 6; } );

    refinementSurfaces
    {
        model
        {
            level (4 5);                                     // the wheel
            patchInfo { type wall; inGroups (modelGroup); }
            regions
            {
                wing { level (5 6); }                        // thin trailing edge: cells under 1/3 of its thickness
            }
        }
    }
    resolveFeatureAngle 30;

    refinementRegions
    {
        farWake  { mode inside; level 1; }
        near     { mode inside; level 2; }
        close    { mode inside; level 3; }
        wingZone { mode inside; level 4; }
        contact  { mode inside; level 5; }
    }

    insidePoint (2.0 1.2 1.0);                               // a point in the air, away from every surface
    allowFreeStandingZoneFaces true;
}

snapControls
{
    nSmoothPatch        3;
    tolerance           2.0;
    nSolveIter          50;
    nRelaxIter          5;
    nFeatureSnapIter    10;
    implicitFeatureSnap false;
    explicitFeatureSnap true;
    multiRegionFeatureSnap false;
}

addLayersControls
{
    relativeSizes       true;
    layers
    {
        model_wing  { nSurfaceLayers 3; }
        model_wheel { nSurfaceLayers 3; }
        // no layers on the ground: they collapse at the tyre contact; wall functions handle the moving ground
    }
    expansionRatio      1.25;
    finalLayerThickness 0.4;
    minThickness        0.1;
    nGrow               0;
    featureAngle        120;
    slipFeatureAngle    30;
    nRelaxIter          5;
    nSmoothSurfaceNormals 1;
    nSmoothNormals      3;
    nSmoothThickness    10;
    maxFaceThicknessRatio 0.5;
    maxThicknessToMedialRatio 0.3;
    minMedianAxisAngle  90;
    nBufferCellsNoExtrude 0;
    nLayerIter          50;
}

meshQualityControls { #include "meshQualityDict" }

writeFlags ( scalarLevels layerSets layerFields );
mergeTolerance 1e-6;

