FoamFile
{
    format      ascii;
    class       dictionary;
    location    "system";
    object      controlDict;
}

solver          incompressibleFluid;
startFrom       latestTime;
startTime       0;
stopAt          endTime;
endTime         2000;       // Allrun sets this from its second argument
deltaT          1;
writeControl    timeStep;
writeInterval   500;
purgeWrite      2;
writeFormat     binary;
writePrecision  8;
timeFormat      general;
timePrecision   6;
runTimeModifiable true;

functions
{
    #includeFunc residuals(p, U, k, omega)
    #includeFunc yPlus
    #includeFunc time

    forcesTotal         // whole body, half model; the toolkit's chart script reads this
    {
        type        forces;
        libs        ("libforces.so");
        patches     (ahmedGroup);
        rho         rhoInf;
        rhoInf      1.205;
        CofR        (-0.522 0 0);
        writeControl timeStep;
        writeInterval 1;
        log         no;
    }

    forceCoeffs         // Cd and Cl on the half model's frontal area (0.0560 m2) = the full body's coefficients
    {
        type        forceCoeffs;
        libs        ("libforces.so");
        patches     (ahmedGroup);
        rho         rhoInf;
        rhoInf      1.205;
        CofR        (-0.522 0 0);
        dragDir     (-1 0 0);
        liftDir     (0 0 1);
        pitchAxis   (0 1 0);
        magUInf     40;
        lRef        1.044;
        Aref        0.0560;
        writeControl timeStep;
        writeInterval 1;
        log         yes;
    }
}
