# Data guard over the whole history (every file version, commit author and message) before anything leaves this machine.
PY=python3
if ! python3 -c "" >/dev/null 2>&1; then PY=python; fi
exec "$PY" "$(git rev-parse --show-toplevel)/tools/data_guard.py" --history
