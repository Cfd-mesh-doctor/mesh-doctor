# Run Mesh Doctor from a clone without installing it.  Put this folder on PATH
# (or link this file into ~/bin):   meshdoctor help
here=$(dirname "$(readlink -f "$0")")
PYTHONPATH="$(cd "$here/.." && pwd)${PYTHONPATH:+:$PYTHONPATH}" exec python3 -m meshdoctor "$@"
