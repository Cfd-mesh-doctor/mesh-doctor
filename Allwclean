# Remove build output of the Mesh Doctor OpenFOAM utilities.
cd "${0%/*}" || exit 1
[ -n "$WM_PROJECT_DIR" ] || { echo "Source OpenFOAM 14 first." >&2; exit 1; }
for d in foam/foamMeshDoctor foam/foamResidualHotspots foam/experimental/foamMeshPolish; do
    wclean "$d"
done
